0:["5vSUFzYC0EHApdVApNezs",[[["",{"children":["privacy",{"children":["__PAGE__",{}]}]},"$undefined","$undefined",true],["",{"children":["privacy",{"children":["__PAGE__",{},[["$L1",[["$","$L2",null,{}],["$","main",null,{"className":"min-h-screen pt-24 pb-16","children":["$","div",null,{"className":"max-w-3xl mx-auto px-4 sm:px-6","children":[["$","h1",null,{"className":"text-3xl font-bold text-white mb-2","children":"Политика конфиденциальности"}],["$","p",null,{"className":"text-white/40 text-sm mb-10","children":"сервиса StudyAssist.ru · Редакция от 01.03.2026"}],["$","div",null,{"className":"space-y-6 text-white/70 leading-relaxed","children":[["$","p",null,{"children":["Настоящая Политика конфиденциальности (далее — Политика) разработана в соответствии с требованиями Федерального закона от 27.07.2006 № 152-ФЗ «О персональных данных» и определяет порядок обработки и защиты персональных данных пользователей сайта"," ",["$","a",null,{"href":"https://studyassist.ru","className":"text-[#6C3EF4] hover:underline","children":"https://studyassist.ru"}]," ","(далее — Сайт)."]}],["$","h2",null,{"className":"text-xl font-semibold text-white pt-2","children":"1. Оператор персональных данных"}],["$","p",null,{"children":"Оператором персональных данных является Приходько Денис Сергеевич (ИНН: 701740486305), осуществляющий деятельность в качестве плательщика налога на профессиональный доход (самозанятый) под обозначением StudyAssist.ru."}],["$","p",null,{"children":"Контактные данные Оператора:"}],["$","ul",null,{"className":"list-none space-y-1 pl-0","children":[["$","li",null,{"children":["E-mail: ",["$","a",null,{"href":"mailto:support@studyassist.ru","className":"text-[#6C3EF4] hover:underline","children":"support@studyassist.ru"}]]}],["$","li",null,{"children":["Телефон: ",["$","a",null,{"href":"tel:+79539246817","className":"text-[#6C3EF4] hover:underline","children":"+7-953-924-68-17"}]]}]]}],["$","h2",null,{"className":"text-xl font-semibold text-white pt-2","children":"2. Категории субъектов и состав персональных данных"}],["$","p",null,{"children":"2.1. Оператор обрабатывает персональные данные следующих категорий субъектов: физических лиц, использующих Сайт, регистрирующихся в личном кабинете, оформляющих заказы, направляющих заявки или иным образом взаимодействующих с сервисом."}],["$","p",null,{"children":"2.2. В зависимости от характера взаимодействия обрабатываются следующие категории данных:"}],["$","ul",null,{"className":"space-y-1 pl-4 list-none","children":[["$","li","фамилия, имя, отчество (при регистрации или оформлении заказа);",{"className":"flex gap-2","children":[["$","span",null,{"className":"text-[#6C3EF4] flex-shrink-0","children":"—"}],"фамилия, имя, отчество (при регистрации или оформлении заказа);"]}],["$","li","адрес электронной почты;",{"className":"flex gap-2","children":[["$","span",null,{"className":"text-[#6C3EF4] flex-shrink-0","children":"—"}],"адрес электронной почты;"]}],["$","li","номер телефона (при его указании пользователем);",{"className":"flex gap-2","children":[["$","span",null,{"className":"text-[#6C3EF4] flex-shrink-0","children":"—"}],"номер телефона (при его указании пользователем);"]}],["$","li","IP-адрес, данные cookie, сведения о браузере и устройстве (автоматически при посещении Сайта);",{"className":"flex gap-2","children":[["$","span",null,{"className":"text-[#6C3EF4] flex-shrink-0","children":"—"}],"IP-адрес, данные cookie, сведения о браузере и устройстве (автоматически при посещении Сайта);"]}],["$","li","информация, содержащаяся в обращениях и заказах пользователя;",{"className":"flex gap-2","children":[["$","span",null,{"className":"text-[#6C3EF4] flex-shrink-0","children":"—"}],"информация, содержащаяся в обращениях и заказах пользователя;"]}],["$","li","платёжные реквизиты (в объёме, необходимом для проведения расчётов, через платёжного партнёра).",{"className":"flex gap-2","children":[["$","span",null,{"className":"text-[#6C3EF4] flex-shrink-0","children":"—"}],"платёжные реквизиты (в объёме, необходимом для проведения расчётов, через платёжного партнёра)."]}]]}],["$","p",null,{"children":"2.3. Оператор не обрабатывает специальные категории персональных данных (расовая, национальная принадлежность, политические взгляды, религиозные убеждения, состояние здоровья, биометрические данные)."}],["$","h2",null,{"className":"text-xl font-semibold text-white pt-2","children":"3. Цели обработки персональных данных"}],["$","p",null,{"children":"Персональные данные обрабатываются в следующих целях:"}],["$","ul",null,{"className":"space-y-1 pl-4 list-none","children":[["$","li","регистрация и идентификация пользователя на Сайте;",{"className":"flex gap-2","children":[["$","span",null,{"className":"text-[#6C3EF4] flex-shrink-0","children":"—"}],"регистрация и идентификация пользователя на Сайте;"]}],["$","li","приём, исполнение и учёт заказов;",{"className":"flex gap-2","children":[["$","span",null,{"className":"text-[#6C3EF4] flex-shrink-0","children":"—"}],"приём, исполнение и учёт заказов;"]}],["$","li","осуществление расчётов и проведение платежей;",{"className":"flex gap-2","children":[["$","span",null,{"className":"text-[#6C3EF4] flex-shrink-0","children":"—"}],"осуществление расчётов и проведение платежей;"]}],["$","li","связь с пользователем по вопросам, связанным с заказом;",{"className":"flex gap-2","children":[["$","span",null,{"className":"text-[#6C3EF4] flex-shrink-0","children":"—"}],"связь с пользователем по вопросам, связанным с заказом;"]}],["$","li","направление информационных и сервисных уведомлений (статус заказа, изменение документов сервиса);",{"className":"flex gap-2","children":[["$","span",null,{"className":"text-[#6C3EF4] flex-shrink-0","children":"—"}],"направление информационных и сервисных уведомлений (статус заказа, изменение документов сервиса);"]}],["$","li","направление рекламных и маркетинговых материалов — при наличии отдельного согласия;",{"className":"flex gap-2","children":[["$","span",null,{"className":"text-[#6C3EF4] flex-shrink-0","children":"—"}],"направление рекламных и маркетинговых материалов — при наличии отдельного согласия;"]}],["$","li","улучшение качества сервиса и анализ пользовательского поведения;",{"className":"flex gap-2","children":[["$","span",null,{"className":"text-[#6C3EF4] flex-shrink-0","children":"—"}],"улучшение качества сервиса и анализ пользовательского поведения;"]}],["$","li","исполнение требований законодательства Российской Федерации;",{"className":"flex gap-2","children":[["$","span",null,{"className":"text-[#6C3EF4] flex-shrink-0","children":"—"}],"исполнение требований законодательства Российской Федерации;"]}],["$","li","защита прав и законных интересов Оператора.",{"className":"flex gap-2","children":[["$","span",null,{"className":"text-[#6C3EF4] flex-shrink-0","children":"—"}],"защита прав и законных интересов Оператора."]}]]}],["$","h2",null,{"className":"text-xl font-semibold text-white pt-2","children":"4. Правовые основания обработки"}],["$","p",null,{"children":"4.1. Обработка персональных данных осуществляется на следующих правовых основаниях:"}],["$","ul",null,{"className":"space-y-1 pl-4 list-none","children":[["$","li","согласие субъекта персональных данных (ст. 6, ч. 1, п. 1 Закона № 152-ФЗ);",{"className":"flex gap-2","children":[["$","span",null,{"className":"text-[#6C3EF4] flex-shrink-0","children":"—"}],"согласие субъекта персональных данных (ст. 6, ч. 1, п. 1 Закона № 152-ФЗ);"]}],["$","li","исполнение договора, стороной которого является субъект персональных данных (ст. 6, ч. 1, п. 5 Закона № 152-ФЗ);",{"className":"flex gap-2","children":[["$","span",null,{"className":"text-[#6C3EF4] flex-shrink-0","children":"—"}],"исполнение договора, стороной которого является субъект персональных данных (ст. 6, ч. 1, п. 5 Закона № 152-ФЗ);"]}],["$","li","исполнение обязанностей, возложенных на Оператора законодательством Российской Федерации (ст. 6, ч. 1, п. 2 Закона № 152-ФЗ);",{"className":"flex gap-2","children":[["$","span",null,{"className":"text-[#6C3EF4] flex-shrink-0","children":"—"}],"исполнение обязанностей, возложенных на Оператора законодательством Российской Федерации (ст. 6, ч. 1, п. 2 Закона № 152-ФЗ);"]}],["$","li","осуществление прав и законных интересов Оператора (ст. 6, ч. 1, п. 7 Закона № 152-ФЗ).",{"className":"flex gap-2","children":[["$","span",null,{"className":"text-[#6C3EF4] flex-shrink-0","children":"—"}],"осуществление прав и законных интересов Оператора (ст. 6, ч. 1, п. 7 Закона № 152-ФЗ)."]}]]}],["$","h2",null,{"className":"text-xl font-semibold text-white pt-2","children":"5. Порядок и условия обработки"}],["$","p",null,{"children":"5.1. Обработка персональных данных осуществляется с использованием средств автоматизации и без таковых."}],["$","p",null,{"children":"5.2. Оператор принимает необходимые правовые, организационные и технические меры для защиты персональных данных от неправомерного или случайного доступа, уничтожения, изменения, блокирования, копирования, распространения, а также иных неправомерных действий."}],["$","p",null,{"children":"5.3. Персональные данные хранятся не дольше, чем этого требуют цели их обработки, и уничтожаются по достижении таких целей или при утрате необходимости в их достижении, если иной срок не установлен законом или договором."}],["$","p",null,{"children":"5.4. Обработка персональных данных осуществляется на территории Российской Федерации. Хранение персональных данных граждан Российской Федерации осуществляется на серверах, расположенных на территории Российской Федерации, в соответствии с ч. 5 ст. 18 Закона № 152-ФЗ."}],["$","h2",null,{"className":"text-xl font-semibold text-white pt-2","children":"6. Передача персональных данных третьим лицам"}],["$","p",null,{"children":"6.1. Оператор не передаёт персональные данные третьим лицам без согласия субъекта, за исключением случаев, когда такая передача необходима для исполнения договора с субъектом, предусмотрена законодательством или осуществляется лицам, оказывающим Оператору услуги на основании договоров (платёжные сервисы, провайдеры хостинга, сервисы рассылок)."}],["$","p",null,{"children":"6.2. Лица, которым переданы персональные данные, обязаны обеспечивать их конфиденциальность и безопасность в объёме не меньшем, чем предусмотрено настоящей Политикой."}],["$","p",null,{"children":"6.3. Трансграничная передача персональных данных осуществляется с соблюдением требований ст. 12 Закона № 152-ФЗ и только в страны, обеспечивающие адекватную защиту прав субъектов персональных данных, либо на основании согласия субъекта."}],["$","h2",null,{"className":"text-xl font-semibold text-white pt-2","children":"7. Файлы cookie и аналитика"}],["$","p",null,{"children":"7.1. Сайт использует файлы cookie — небольшие текстовые файлы, сохраняемые на устройстве пользователя. Cookie позволяют поддерживать сессию, сохранять настройки, анализировать трафик и улучшать работу сервиса."}],["$","p",null,{"children":"7.2. Пользователь вправе отключить cookie в настройках браузера, однако это может повлечь ограничение доступа к отдельным функциям Сайта."}],["$","p",null,{"children":"7.3. На Сайте могут использоваться инструменты веб-аналитики (Яндекс.Метрика и аналогичные сервисы). Данные, собранные такими инструментами, обрабатываются в обезличенном или агрегированном виде."}],["$","h2",null,{"className":"text-xl font-semibold text-white pt-2","children":"8. Права субъекта персональных данных"}],["$","p",null,{"children":"8.1. Субъект персональных данных вправе:"}],["$","ul",null,{"className":"space-y-1 pl-4 list-none","children":[["$","li","получить сведения об обработке своих персональных данных Оператором;",{"className":"flex gap-2","children":[["$","span",null,{"className":"text-[#6C3EF4] flex-shrink-0","children":"—"}],"получить сведения об обработке своих персональных данных Оператором;"]}],["$","li","потребовать уточнения, блокирования или уничтожения персональных данных в случаях, предусмотренных законом;",{"className":"flex gap-2","children":[["$","s