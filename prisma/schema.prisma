// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified Boolean   @default(false)
  name          String?
  phone         String?
  passwordHash  String?
  avatar        String?  @db.Text
  isAdmin       Boolean   @default(false)
  provider      String?   // 'vk' | 'mailru' | 'yandex' | 'credentials'
  providerId    String?
  telegramId         String?   // для DM через бот
  telegramLinkToken  String?   @unique  // временный токен для привязки бота
  telegramLinkExpiry DateTime?          // срок действия токена
  // Согласия (152-ФЗ)
  consentPdAt        DateTime? // дата согласия на обработку ПД
  consentMarketing   Boolean   @default(false) // согласие на маркетинговые рассылки
  consentMarketingAt DateTime? // дата согласия на рассылки
  // Трекинг входов
  lastLoginAt   DateTime?
  prevLoginAt   DateTime?
  lastIp        String?
  prevIp        String?
  lastCountry   String?
  lastUserAgent String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  orders       Order[]
  reviews      Review[]
  payments     Payment[]
  accounts     Account[]
  sessions     Session[]

  @@index([email])
  @@index([providerId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Order {
  id           String    @id @default(cuid())
  userId       String?
  // Контакты гостя (если нет аккаунта)
  clientName   String?
  clientEmail  String?
  clientPhone  String?
  type        String    // 'coursework' | 'diploma' | 'essay' | 'lab' | 'presentation' | 'other'
  subject     String
  deadline    DateTime
  description String    @db.Text
  files       String?   @db.Text // JSON array of file paths
  status      String    @default("new")
  // Статусы: new | in_progress | ready_for_review | awaiting_payment | paid | completed | cancelled
  price       Decimal?  @db.Decimal(10, 2)
  paymentLink String?   @db.Text
  paymentId   String?
  adminNote   String?   @db.Text
  resultFiles  String?   @db.Text  // JSON: файлы готовой работы от админа
  revisionNote String?   @db.Text  // Текст замечаний от заказчика
  revisionFiles String?  @db.Text  // JSON: файлы замечаний от заказчика
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User?     @relation(fields: [userId], references: [id])
  payments    Payment[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Payment {
  id         String   @id @default(cuid())
  orderId    String
  userId     String?
  amount     Decimal  @db.Decimal(10, 2)
  status     String   // 'pending' | 'succeeded' | 'cancelled'
  yukassaId  String?
  metadata   String?  @db.Text // JSON
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  order      Order    @relation(fields: [orderId], references: [id])
  user       User?    @relation(fields: [userId], references: [id])

  @@index([orderId])
  @@index([userId])
  @@index([yukassaId])
}

model Review {
  id         String   @id @default(cuid())
  userId     String?
  name       String
  city       String?
  university String?
  rating     Int
  text       String   @db.Text
  avatar     String?
  approved   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User?    @relation(fields: [userId], references: [id])

  @@index([approved])
  @@index([userId])
}

model ChatSession {
  id           String        @id @default(cuid())
  name         String?
  contact      String?       // email / телефон / @telegram / vk.com/... / wa:...
  tgGroupMsgId Int?          // message_id первого сообщения бота в группе поддержки
  status       String        @default("open") // open | closed
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  messages     ChatMessage[]

  @@index([status])
  @@index([createdAt])
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  text      String      @db.Text
  fromAdmin Boolean     @default(false)
  createdAt DateTime    @default(now())
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
}

model Post {
  id          String    @id @default(cuid())
  type        String    // 'blog' | 'news'
  title       String
  slug        String    @unique
  excerpt     String?   @db.Text
  content     String    @db.Text
  coverImage  String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([type, published])
  @@index([slug])
  @@index([publishedAt])
}

model PortfolioItem {
  id          String   @id @default(cuid())
  title       String
  workType    String   // essay | coursework | diploma | lab | presentation | other
  subject     String?
  description String?  @db.Text
  previewText String?  @db.Text  // краткий фрагмент работы (обезличенный)
  fileUrl     String?            // ссылка на PDF (необязательно)
  published   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published])
  @@index([workType])
  @@index([sortOrder])
}
